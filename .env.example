# Copy to .env and edit. All values are optional for local development.
DATABASE_URL=sqlite:///./homefind.db
# CHANGE THIS in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
SEED_ON_STARTUP=true
# Illustrative mortgage rates (percent). Replace with a real rates provider in production.
RATE_30Y_FIXED=6.38
RATE_15Y_FIXED=5.62
RATE_5_1_ARM=5.95
RATE_FHA_30Y=6.10

# Optional: absolute path to the frontend's built "dist" folder to serve the website from this API as well.
# Leave empty when the frontend is hosted separately.
FRONTEND_DIST=
